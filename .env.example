# App
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Database (local compose o RDS en produccion)
DB_HOST=db
DB_PORT=5432
DB_USER=semisocial_user
# En AWS usar clave real, no publicarla en repositorios
DB_PASSWORD=semisocial_password
DB_NAME=semisocial_db

# Postgres variables para auto-iniciar el contenedor en local
POSTGRES_USER=semisocial_user
POSTGRES_PASSWORD=semisocial_password
POSTGRES_DB=semisocial_db

# AWS (Credenciales y configuraciones de servicios)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
# Solo usar AWS_SESSION_TOKEN si estás usando una cuenta de AWS Academy/Educate
AWS_SESSION_TOKEN=

# Buckets S3
S3_BUCKET_IMAGES=semi1proyecto-g6
S3_BUCKET_WEB=Proyecto-Web-G6

# Cognito
COGNITO_USER_POOL_ID=tu_user_pool_id
COGNITO_CLIENT_ID=tu_client_id
COGNITO_REGION=us-east-1

# Servicios de IA
REKOGNITION_COLLECTION_ID=tu_collection_id
LEX_BOT_ID=tu_bot_id
LEX_BOT_ALIAS_ID=tu_alias_id
LEX_LOCALE_ID=es_US
TRANSLATE_TARGET_LANG=es

# API Gateway (trigger de la Lambda de subida)
IMAGE_UPLOAD_API_URL=https://tu-api.execute-api.us-east-1.amazonaws.com/prod/upload
